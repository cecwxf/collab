{
  "name": "@cecwxf/dsh-room",
  "version": "0.3.4",
  "description": "DSH Room — DeepSeek Harness plugin for accountless E2EE Collab rooms (sidebar: DSH Room)",
  "type": "module",
  "license": "MIT",
  "author": "cecwxf",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek",
    "deepseek-harness",
    "collab",
    "e2ee",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecwxf/collab.git",
    "directory": "packages/dsh-room"
  },
  "bugs": {
    "url": "https://github.com/cecwxf/collab/issues"
  },
  "homepage": "https://github.com/cecwxf/collab/tree/master/packages/dsh-room",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist",
    "scripts/ensure-dist.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist/types && node build.mjs",
    "prepare": "node scripts/ensure-dist.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "multicast-dns": "^7.2.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@collab/lan-relay": "0.1.0",
    "@collab/protocol": "0.1.0",
    "@collab/sdk": "0.1.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
