{
  "name": "@collab/lan-relay",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "collab-lan-relay": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@collab/protocol": "0.1.0",
    "multicast-dns": "^7.2.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "description": "Local Collab LAN relay (same NDJSON protocol as CF) with mDNS discovery",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
