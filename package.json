{
  "name": "collab",
  "version": "0.1.0",
  "private": true,
  "description": "Peer collab rooms for DeepSeek Harness — install via `dsh plugin add @cecwxf/dsh-room` or github:cecwxf/collab#master",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @collab/protocol && npm run build -w @collab/sdk && npm run build -w @collab/lan-relay && npm run build -w @collab/cli && npm run build -w @cecwxf/dsh-room && npm run build -w @collab/relay",
    "test": "npm run test -w @collab/protocol && npm run test -w @collab/sdk && npm run test -w @collab/lan-relay && npm run test -w @collab/relay && npm run test -w @cecwxf/dsh-room",
    "smoke": "node scripts/smoke-two-agents.mjs",
    "cli": "node packages/cli/dist/cli.js",
    "e2e:live": "node scripts/e2e-live.mjs 20",
    "e2e:dsh:local": "node scripts/e2e-dsh-local.mjs",
    "e2e:dsh:real": "node scripts/e2e-dsh-real.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "type": "module",
  "main": "./packages/dsh-room/dist/index.js",
  "exports": {
    ".": "./packages/dsh-room/dist/index.js",
    "./client": "./packages/dsh-room/dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "packages/dsh-room/dist",
    "packages/dsh-room/README.md",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "collab",
    "e2ee"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecwxf/collab.git"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "multicast-dns": "^7.2.5",
    "ws": "^8.18.3"
  }
}
